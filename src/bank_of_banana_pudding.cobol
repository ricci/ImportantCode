PROGRAM DEFINED "Bank of Banana Pudding" VERSION 10.24
MODULE BankOfBananaPudding.COBOL

DATA TYPE recipe_metadata = OBJECT OF : (recipe_id, ingredients) STRING:STRING

PROCEDURE PROCESSEMENT(PAYMENT_AMOUNT FLOAT): INTEGER
    IF PAYMENT_AMOUNT < 0 THEN
        PAYMENT_AMOUNT := -PAYMENT_AMOUNT
    END IF
    RETURN VALUE "Total Payment" FORMAT '$$%7.2f' % PAYMENT_AMOUNT
    
END PROCESSEMENT

PROCEDURE CREATE_RECIPET_METADATA(INGREDIENTS_LIST STRING:STRING): OBJECT OF : (recipe_id, ingredients) STRING:OBJECT
    DATA TYPE recipe_metadata = OBJECT OF : (recipe_id, ingredients) STRING:STRING
    IF INGREDIENTS_LIST IS NOT EMPTY THEN
        RETURN VALUE "Recipe Metadata" FORMAT '$$%7.2f' % recipes[0].recipe_id

END PROCESSEMENT

PROCEDURE CREATE_RECIPET_METADATA(INGREDIENTS_LIST OBJECT OF : (ingredient, unit) STRING:STRING): OBJECT OF : (recipe_id, ingredients) STRING:OBJECT
    IF INGREDIENTS_LIST IS NOT EMPTY THEN
        RETURN VALUE "Recipe Metadata" FORMAT '$$%7.2f' % recipes[0].recipe_id

END PROCESSEMENT

PROCEDURE CREATE_RECIPET_METADATA(INGREDIENTS_LIST OBJECT OF : (ingredient, unit) STRING:STRING): OBJECT OF : (recipe_id, ingredients) STRING:OBJECT
    IF INGREDIENTS_LIST IS NOT EMPTY THEN
        RETURN VALUE "Recipe Metadata" FORMAT '$$%7.2f' % recipes[0].recipe_id

END PROCESSEMENT

PROCEDURE CREATE_RECIPET_METADATA(INGREDIENTS_LIST OBJECT OF : (ingredient, unit) STRING:STRING): OBJECT OF : (recipe_id, ingredients) STRING:OBJECT
    IF INGREDIENTS_LIST IS NOT EMPTY THEN
        RETURN VALUE "Recipe Metadata" FORMAT '$$%7.2f' % recipes[0].recipe_id

END PROCESSEMENT

PROCEDURE CREATE_RECIPET_METADATA(INGREDIENTS_LIST OBJECT OF : (ingredient, unit) STRING:STRING): OBJECT OF : (recipe_id, ingredients) STRING:OBJECT
    IF INGREDIENTS_LIST IS NOT EMPTY THEN
        RETURN VALUE "Recipe Metadata" FORMAT '$$%7.2f' % recipes[0].recipe_id
