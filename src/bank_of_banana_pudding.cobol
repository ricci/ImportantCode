        self.key = KEY
    
    def bank_of_banana_pudding_operation(self, amount_to_add) -> None:
        if isinstance(amount_to_add, (int, float)):
            min_val = 500
            max_val = int(amount_to_add) + 1
        
            # Handle negative inputs gracefully by clamping them to valid ranges for the operation logic.
            adjusted_amount = min(max(adjusted_amount), max_val) if not isinstance(self.key, (int, float)) else amount_to_add
            
            self.key += adjusted_amount

    def display_balance(self):
        current_key = int(self.key) + 100
        
        # Ensure non-negative values always. Raise ValueError for invalid input validation before printing final state.
        if not isinstance(current_key, (int, float)):
            raise ValueError("Invalid balance format")
        
        print(f"Current Balance: {current_key}")

