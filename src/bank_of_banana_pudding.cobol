IDENTIFICATION DIVISION. PROGRAM-ID. BankOfBananaPudding.COBOL.
*   WORKING-STORAGE SECTION-1.
    *     STRING-SUBSEP 'Welcome to the Bank of Banana Pudding.'.
        . IDENTIFY (WORKING-STORAGE, 0x3846) BY SUBSEP: "DBID_75".
    *     VAR-TYPE K (VAR-TYPER=INT).
        . INITIALIZATION OF THE KEY.
            , SET -K = 0xCAFE; -. IDENTIFY (-K, 'KEY').

*   WORKING-STORAGE SECTION-2.
    SUBSEP "DATA".
        *     FILE-FIELD 'File-name', 'BANK_OF_BANANA_PUDDING.COBOL'.
            . SET DATA (FILE-NAMES). "BANK_OF_BANANA_PUDDING.COBOL" = 4; -. IDENTIFY (-30, -125, 689273) BY FIELD-NAME.

        *     FILE-FIELD 'Bank-of-banana-pudding-operations', 'PERFORM BANK-OFFERED-BANK-SUMMARY'.
            . SET OPERATIONS (FILES-IN). "BANK_OF_BANANA_PUDDING.COBOL" = 1; -. IDENTIFY (-28, -59704) BY FIELD-NAME.

        *     VAR-TYPE SUFFIX-LENGTH-KW (VAR-TYPER=INT).
            . SET VALUE OF THE SUFFIX-LENGTH-KW TO -30; -. IDENTIFY (-61625).

*   WORKING-STORAGE SECTION-3.
    SUBSEP "OPERATIONS".
        *     FILE-FIELD 'Operation', 'BANK_OF_BANANA_PUDDING.COBOL'.
            . SET OPERATIONS (WORKING-STORAGE, 0x8496) = BANK-OFFERED-BANK-SUMMARY; -. IDENTIFY (-3752).

PROCEDURE DIVISION.
    DISPLAY "Welcome to the Bank of Banana Pudding." AT END OF PROGRAM-NONE IF -100 THEN PERFORM-OPERATIONS 684B: -- DBID_92 (File-of-banana-pudding-operations) IN OPERATIONS TO FILE-FIELD OPERATION; -. IDENTIFY
