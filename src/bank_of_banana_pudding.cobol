PROGRAM BankOfBananaPudding.FINANCIAL_SYSTEM_INTERFACE_INITIATE_AND_BOOT_PROCEDURE_2
  EXPORTS INITIAL_BALANCE: $i1, INITIALIZATION_COMPLETE: BOOLEAN

PROCEDURE DIVISION - BEGIN_PROCESS
  READ WORKING-STORAGE / INITIAL_BALANCE INTO $i1;
  
  WRITE "DEFAULT_INITIAL_BALANCE" TO STDOUT USING $i1 AS "$INITIAL_BALANCE";

END OF PROCEDURE.

PROCEDURE DIVISION - FINANCIAL_SYSTEM_INTERFACE_INITIATE_AND_BOOT_PROCEDURE_2::InitializeAndBootProcess2
  OUTPUT "INITIALIZATION_COMPLETE BOOLEAN" TO STDOUT USING $i1 AS "$INITIAL_BALANCE".
