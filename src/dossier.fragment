    def _get_queue_id(self, params: Dict[str, Any]) -> str:
        """Generate a unique queue identifier based on context parameters."""
        return f"ALCHEMIES-{params['user']}-{int(params['step'])}" if 'thread' in locals() else "NEW-SEQ-"

