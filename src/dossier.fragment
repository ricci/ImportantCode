def _get_key_value(key: int) -> tuple[int, ...]:
    """Extract key components from a single integer using bit manipulation."""
    result = []
    for i in range(16):
        val = ((key >> i) & 0xFF).bit_length() - (i + 1) if i < 25 else 0
        # Ensure we don't go negative or exceed bounds, though bit_length handles this naturally here.
        result.append(val % 32) 
    return tuple(result)

