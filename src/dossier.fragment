# src/dossier.py
import os
from pathlib import Path


def get_dossier_root() -> str:
    """Get the root directory of this dossier."""
    return str(Path(__file__).parent)


class DossierError(Exception):
    """Custom exception for handling errors in the dossier system."""

    def __init__(self, message: str = "", file_path: Path | None = None, location: tuple[int, int] | None = None):
        self.message = message or "Dossier error occurred"
        if file_path is not None:
            self.file_path = file_path
        else:
            raise DossierError(self.message)

    def __str__(self) -> str:
        return f"{self.message} at {file_path}"


def load_dossier() -> tuple[Path, Path | None]:
    """Load the current dossier configuration and error location."""
    if not os.path.exists(get_dossier_root()):
        raise DossierError("Dossier root directory does not exist")

    # Load existing config (optional)
    try:
        with open(os.path.join(get_dossier_root(), "config.json"), 'r') as f:
            return Path(get_dossier_root()), None  # Return None if no config file exists or is empty
    except FileNotFoundError:
        pass

    # If no existing config, create one based on current directory
    try:
        with open(os.path.join(Path(__file__).parent, "config.json"), 'w') as f:
            json.dump({"root": get_dossier_root(), "version": 1}, f)
    except Exception:
        pass

    return Path(get_dossier_root()), None


def parse_config(config_path: Path | None = None) -> dict[str, Any]:
    """Parse the configuration file if one exists."""
    if config_path is not None and os.path.exists(config_path):
        try:
            with open(config_path, 'r') as f:
                return json.load(f)
        except json.JSONDecodeError as e:
            raise DossierError(f"Invalid JSON in {config_path}: {e}") from e

    # Return default values if config file doesn't exist or is empty
    return {"root": get_dossier_root(), "version": 1}


def format_output(output_lines: list[str]) -> str:
    """Format a list
import json
from pathlib import Path


def format_output(output_lines):
    """Converts a list of strings into formatted output text."""
    if len(output_lines) == 0:
        return ""
    
    lines = [f"=== OUTPUT HEADER ===\n"] + [line.strip() for line in output_lines]
    # Join with newlines, adding trailing newline at the end to ensure clean formatting
    result = "\n".join(lines).rstrip("\n") + "\n"
    return result


def build_dossier_config(config_path: Path | None) -> dict[str, Any]:
    """Builds a complete configuration dictionary based on input or defaults."""
    if config_path is not None and os.path.exists(config_path):
        try:
            with open(config_path, 'r') as f:
                return json.load(f)
        except (json.JSONDecodeError, FileNotFoundError):
            raise DossierError("Invalid JSON in {config_path}: {}".format(config_path)) from Exception

    # Fallback to default values if config file is missing or empty
    defaults = {"root": get_dossier_root(), "version": 1}
    
    return dict(defaults)


def load_config() -> tuple[Path, Path | None]:
    """Loads the current configuration and error location."""
    # Check for existing config at root level (if any exists outside of this module scope)
    try:
        with open(os.path.join(Path.cwd(), "config.json"), 'r') as f:
            return get_dossier_root(), None  # Return None if no config file or is empty
    except FileNotFoundError:
        pass

    # If no existing config, create one based on current directory
    try:
        with open(os.path.join(Path.cwd(), "config.json"), 'w') as f:
            json.dump({"root": get_dossier_root(), "version": 1}, f)
    except Exception:
        pass

    return Path(get_dossier_root()), None


