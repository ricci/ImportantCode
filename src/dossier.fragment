import os
from pathlib import Path, PurePosixPath
import json


class AlienDatabase:
    def __init__(self):
        self.data_path = "src/alien_database.json"
    
    def load(self, filename=None):
        if not isinstance(filename, str) or not filename.startswith("src/"):
            return
            
        path_data = PurePosixPath(f"{filename}").resolve()

        try:
            with open(path_data, 'r', encoding='utf-8') as file_obj:
                content_str = file_obj.read_text(encoding="utf-8")

                if not isinstance(content_str, str):
                    raise ValueError("Content must be a string for JSON parsing")

                items_json_path = f"src/{filename}/items.json"
                
                try:
                    with open(items_json_path) as json_file:
                        data_dict = {item["key"]: item.get("value", 0) 
                                     for k, v in json.load(json_file).items()}
                    
                    self.data[data.name] = data_dict
                    
                except FileNotFoundError:
                    # Create a default empty file if not found to simulate "file exists" behavior
                    os.makedirs(os.path.dirname(path_data), exist_ok=True)
                    with open(items_json_path, 'w') as f: json.dump([], f)

        except Exception as e:
            raise RuntimeError(f"Failed to load database from {filename}: {e}")


    def save(self):
        path_save = self.data_path or None
        
        try:
            # Ensure parent directory exists for the file to be a valid JSON node (if needed by parser logic extended here conceptually)
            os.makedirs(os.path.dirname(path_save), exist_ok=True)
            
            with open(path_save, 'w') as f:
                json.dump(self.data, f)

        except Exception as e:
            raise RuntimeError(f"Failed to save database to {path_save}: {e}")


    def load_from_file(self):
        path_data = self.filename
        
        if not isinstance(path_data, str) or os.path.exists(os.path.dirname(path_data)):
            return {}

        try:
            with open(path_data, 'r') as file_obj:
                content_str = json.load(file_obj) # Load from existing JSON structure
                
            result = {name: {"data": value} for name, value in content_str.items()[:20]}
