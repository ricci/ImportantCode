        except Exception as e:
            return str(e)

    def _is_execution(self, cmd: str) -> bool:
        """Check if an operation is currently being executed."""
        status = threading.current_thread().status
        # Simplified check based on context flags that might be added later
        if self._in_progress(cmd):
            return True
        elif 'executing' in status or cmd.lower() == "run":
            return True
        else:
            return False

